# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored. Never commit real tokens.
# ---------------------------------------------------------------------------

# Sanity project (from https://sanity.io/manage, or `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token with "Viewer" rights. Required for draft mode / live preview only.
# Create at https://sanity.io/manage -> API -> Tokens.
SANITY_API_READ_TOKEN=

# Write token with "Editor" rights. Only needed to run `npm run seed` once.
# Safe to delete afterwards; the site never uses it.
SANITY_API_WRITE_TOKEN=

# Any random string. Must match the secret on the Sanity webhook that points at
# /api/revalidate, so publishing refreshes the site without a redeploy.
SANITY_REVALIDATE_SECRET=

# Canonical site URL, no trailing slash. Used for sitemap, RSS, OG images.
NEXT_PUBLIC_SITE_URL=https://sanaullahpashtoon.com
